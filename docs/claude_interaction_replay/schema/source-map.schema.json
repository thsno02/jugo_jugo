{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jugo-jugo.example/schemas/source-map.schema.json",
  "title": "Version Evidence Source Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mappings"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "2.0.0" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_id", "version_id", "claim_kind", "claim", "evidence_refs", "confidence", "notes"],
        "properties": {
          "mapping_id": { "type": "string" },
          "version_id": { "type": "string" },
          "claim_kind": { "enum": ["origin", "decision", "action", "artifact", "metric", "transition", "risk"] },
          "claim": { "type": "string" },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "enum": ["high", "medium", "low", "conflicting"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
