{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jugo-jugo.example/schemas/module-recall.schema.json",
  "title": "LLM Wiki Module Recall",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "module_id", "title", "kind", "status", "scope", "summary", "design_context",
    "version_ids", "primary_demo_version", "evidence_policy", "stages", "edges",
    "controls", "known_gaps"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.1.0" },
    "module_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["production", "control"] },
    "status": { "enum": ["demo", "partial", "complete"] },
    "scope": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "design_context": { "$ref": "#/$defs/designContext" },
    "version_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^v[0-9]+$" }, "uniqueItems": true },
    "primary_demo_version": { "type": "string", "pattern": "^v[0-9]+$" },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_text", "assistant_text", "repository_artifacts", "fact_status"],
      "properties": {
        "event_text": { "const": "reference_existing_event_by_id" },
        "assistant_text": { "const": "reuse_existing_not_verbatim_summary" },
        "repository_artifacts": { "const": "repo_relative_path_only" },
        "fact_status": { "const": "specified_executed_failure_retrospective_must_be_distinct" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/control" }
    },
    "known_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "rationalePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "event_ids"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "assumptionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "status", "event_ids"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "status": { "enum": ["working", "validated", "revised", "broken"] },
        "event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "designContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "justification", "observations", "assumptions", "success_definition"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rationalePoint" } },
        "assumptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assumptionPoint" } },
        "success_definition": { "type": "string", "minLength": 1 }
      }
    },
    "stageRationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why", "observations", "assumptions"],
      "properties": {
        "why": { "type": "string", "minLength": 1 },
        "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rationalePoint" } },
        "assumptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assumptionPoint" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "role", "fact_status", "claim", "artifact_refs"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["origin", "decision", "execution", "challenge", "correction", "validation", "failure", "retrospective"] },
        "fact_status": { "enum": ["specified", "executed", "observed_failure", "retrospective", "contradicted", "git_verified"] },
        "claim": { "type": "string", "minLength": 1 },
        "artifact_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "status", "summary", "event_ids", "artifact_refs"],
      "properties": {
        "version_id": { "type": "string", "pattern": "^v[0-9]+$" },
        "status": { "enum": ["absent", "introduced", "retained", "modified", "failed", "replaced", "retrospective"] },
        "summary": { "type": "string", "minLength": 1 },
        "event_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "artifact_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id", "sequence", "label", "stage_kind", "summary", "rationale", "inputs", "actions",
        "outputs", "entry_gate", "exit_gate", "outcome", "audit_control_ids",
        "artifact_refs", "evidence", "evolution", "known_gaps"
      ],
      "properties": {
        "stage_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "stage_kind": { "enum": ["intake", "transform", "decision", "gate", "publication", "audit", "feedback"] },
        "summary": { "type": "string", "minLength": 1 },
        "rationale": { "$ref": "#/$defs/stageRationale" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "entry_gate": { "type": ["string", "null"] },
        "exit_gate": { "type": ["string", "null"] },
        "outcome": { "enum": ["specified", "executed", "partial", "failed", "mixed", "retrospective"] },
        "audit_control_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "artifact_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "evolution": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evolution" } },
        "known_gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "label"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "enum": ["flow", "gate", "feedback", "rework"] },
        "label": { "type": "string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id", "label", "category", "object", "method", "pass_condition",
        "fail_action", "automation", "coverage", "status", "evidence", "evolution", "known_gaps"
      ],
      "properties": {
        "control_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "category": { "enum": ["source", "content", "structure", "graph", "process", "state", "cost"] },
        "object": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "pass_condition": { "type": "string", "minLength": 1 },
        "fail_action": { "type": "string", "minLength": 1 },
        "automation": { "enum": ["script", "script_then_agent", "agent", "human_probe"] },
        "coverage": { "enum": ["full", "suspects", "sample", "not_measured"] },
        "status": { "enum": ["specified", "executed", "partial", "missed", "replaced"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "evolution": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evolution" } },
        "known_gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
