{
  "schema": "llm_wiki.loop_manifest.v2",
  "loop_root": "llm_wiki/loop",
  "kb_root": "llm_wiki/kb",
  "active_design": "llm_wiki/loop/LOOP_DESIGN_V2.md",
  "card_contract": "llm_wiki/loop/CARD_CONTRACT_V2.md",
  "brain_root": "llm_wiki/loop/brains",
  "legacy_root": "legacy",
  "system_prompt_root": "llm_wiki/loop/system_prompts",
  "plan_root": "llm_wiki/loop/plans",
  "reflection_root": "llm_wiki/loop/reflections",
  "draft_backlog": "llm_wiki/loop/queues/draft_backlog.md",
  "source_roots": [
    "data/manifests",
    "data/raw",
    "data/logs"
  ],
  "brains": {
    "production": "material intake, scoped draft cards, draft provenance",
    "similarity": "title similarity top3, comparison provenance",
    "audit": "publication audit, fusion audit, process audit",
    "ops": "mailbox routing, lifecycle state, wake markers"
  },
  "loop_owner": "main_owned_with_brain_mailbox",
  "loop_shape": "brain_mailbox_scoped_knowledge_loop",
  "primary_object": "scoped_knowledge_card",
  "language_policy": {
    "human_readable_main_language": "zh",
    "allowed_english": [
      "file_paths",
      "status_codes",
      "schema_fields",
      "commands",
      "package_names",
      "source_titles",
      "References",
      "Footnotes"
    ]
  },
  "current_focus": [
    "从本地来源生长 scoped knowledge cards",
    "为每张卡写可读出处论证",
    "优先批量生成 scoped draft cards",
    "用 Jieba/Jaccard title similarity top3 做候选选择",
    "用三问 comparison provenance 判断新卡、融合和 provenance 增量",
    "通过 brain mailbox 传递 production、similarity、audit 和 ops 信息",
    "用审计证据演化技能和任务模板"
  ],
  "non_goals": [
    "枢纽页",
    "聚类",
    "主题覆盖",
    "低信息量标题改写卡",
    "没有来源支撑的 agent 综合"
  ],
  "card_contract_summary": {
    "required_fields": [
      "id",
      "title",
      "status",
      "card_type",
      "tags",
      "created_time",
      "edited_time",
      "edited_entity",
      "source_ids",
      "provenance_card",
      "aliases",
      "related"
    ],
    "status_values": [
      "draft",
      "accepted",
      "rejected",
      "superseded"
    ],
    "edited_entity_values": [
      "llm",
      "human",
      "llm+human"
    ],
    "tag_rule": "tags 使用 #llm 这种 hashtag 字符串；无固定 taxonomy。",
    "body_rule": "正文无强模板，但必须有知识含量，不能只是 title restatement 或 paraphrase。",
    "section_order_rule": "References 必须早于 Footnotes；Footnotes 必须是最后一个 section。"
  },
  "roles": {
    "main_agent": {
      "system_prompt": "llm_wiki/loop/system_prompts/main_agent.md",
      "owns": [
        "状态迁移",
        "任务包创建",
        "采纳决策",
        "停止逻辑",
        "偏差干预"
      ],
      "must_not_do": [
        "大段来源挖掘",
        "批量写卡",
        "批量 similarity top3 或 comparison provenance",
        "批量审计",
        "批量采纳"
      ]
    },
    "source_mining_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/source_mining_worker.md",
      "task_template": "llm_wiki/loop/task_templates/source_mining_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的一个来源目录或文件",
        "data/manifests/acquired_sources_index.md",
        "data/manifests/sources.jsonl"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录",
        "llm_wiki/kb/candidates"
      ]
    },
    "card_drafting_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_drafting_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_drafting_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的事实候选",
        "当前 task.md 指定的来源片段"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录"
      ]
    },
    "card_batch_drafting_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_batch_drafting_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_batch_drafting_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的事实候选列表",
        "当前 task.md 指定的来源片段"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录"
      ]
    },
    "card_similarity_gate_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_similarity_gate_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_similarity_gate_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的草稿知识卡",
        "当前 task.md 指定的草稿 provenance",
        "llm_wiki/kb/indexes/cards.md",
        "title similarity top3 从 index 中选出的 accepted card 路径",
        "llm_wiki/loop/queues/draft_backlog.md"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录",
        "当前 iteration/artifacts/similarity_top3.md",
        "当前 iteration/artifacts/comparison_provenance"
      ]
    },
    "card_audit_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_audit_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_audit_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的草稿知识卡",
        "当前 task.md 指定的出处论证",
        "当前 task.md 指定的来源片段"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录"
      ]
    },
    "card_batch_audit_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_batch_audit_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_batch_audit_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的草稿知识卡",
        "当前 task.md 指定的出处论证",
        "当前 task.md 指定的来源片段",
        "当前 task.md 指定的相似门报告"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录"
      ]
    },
    "card_fusion_audit_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_fusion_audit_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_fusion_audit_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的 draft card",
        "当前 task.md 指定的 draft provenance",
        "当前 task.md 指定的 comparison provenance",
        "当前 task.md 指定的 accepted A 卡",
        "当前 task.md 指定的 A 卡 provenance",
        "当前 task.md 指定的来源证据"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts/fusion_audit_report.md"
      ]
    },
    "card_fusion_adoption_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_fusion_adoption_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_fusion_adoption_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的 comparison provenance",
        "当前 task.md 指定的 fusion audit pass 报告",
        "当前 task.md 指定的 accepted A 卡",
        "当前 task.md 指定的 A 卡 provenance"
      ],
      "default_allowed_writes": [
        "任务包授权的 accepted A 卡 provenance",
        "任务包明确授权且审计批准时的 accepted A 卡最小正文改动",
        "当前 iteration 目录"
      ]
    },
    "card_adoption_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_adoption_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_adoption_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的审计通过知识卡",
        "当前 task.md 指定的出处论证",
        "当前 task.md 指定的审计结论"
      ],
      "default_allowed_writes": [
        "llm_wiki/kb/cards",
        "llm_wiki/kb/provenance",
        "llm_wiki/kb/indexes",
        "当前 iteration 目录"
      ]
    },
    "card_batch_adoption_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/card_batch_adoption_worker.md",
      "task_template": "llm_wiki/loop/task_templates/card_batch_adoption_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的审计通过知识卡",
        "当前 task.md 指定的出处论证",
        "当前 task.md 指定的批量审计报告",
        "llm_wiki/kb/indexes/cards.md"
      ],
      "default_allowed_writes": [
        "llm_wiki/kb/cards",
        "llm_wiki/kb/provenance",
        "llm_wiki/kb/indexes",
        "当前 iteration 目录"
      ]
    },
    "skill_evolution_worker": {
      "system_prompt": "llm_wiki/loop/system_prompts/skill_evolution_worker.md",
      "task_template": "llm_wiki/loop/task_templates/skill_evolution_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的失败证据",
        "当前 task.md 指定的技能文件",
        "当前 task.md 指定的任务模板"
      ],
      "default_allowed_writes": [
        "llm_wiki/skills",
        "llm_wiki/loop/task_templates",
        "当前 iteration 目录"
      ]
    },
    "independent_evaluator": {
      "system_prompt": "llm_wiki/loop/system_prompts/independent_evaluator.md",
      "task_template": "llm_wiki/loop/task_templates/independent_evaluation_task.md",
      "default_allowed_inputs": [
        "当前 task.md 指定的任务包和产物"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录"
      ]
    },
    "monitor": {
      "system_prompt": "llm_wiki/loop/system_prompts/monitor.md",
      "default_allowed_inputs": [
        "llm_wiki/loop/loop_state.json",
        "当前 iteration 的 loop_status.md",
        "当前 iteration 的 loop_delivery.md",
        "当前 task.md 指定的产物存在性"
      ],
      "default_allowed_writes": [
        "当前 iteration 目录",
        "当前 iteration/artifacts 目录"
      ]
    }
  },
  "required_worker_artifacts": [
    "loop_status.md",
    "loop_delivery.md",
    "read_log.md"
  ],
  "long_horizon_plan": "llm_wiki/loop/plans/main_agent_long_horizon_execution_plan.md",
  "network_policy": {
    "default": "prefer_local_data",
    "max_retrieve_attempts_per_source": 2,
    "on_company_network_failure": "记录失败并搁置，未来在个人设备重试。"
  }
}
